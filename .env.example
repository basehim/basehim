#==============================================================================
# Basehim Environment Configuration
# Copy this file to .env and edit the values for your installation.
#==============================================================================

# Application
APP_NAME="Basehim"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_KEY=

# Database (cPanel MySQL)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=basehim
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
# Prefixes every table Basehim creates, including the tables apps create for
# themselves — so several sites can share one database, which is the norm on
# shared hosting where you get a fixed number of them.
#
# Set it before installing and leave it alone afterwards: changing it later
# points the site at tables that do not exist. Letters, numbers and
# underscores only. Empty means no prefix, which is what every existing
# install has.
DB_PREFIX=

# JWT
JWT_SECRET=please-change-this-to-a-long-random-string-at-least-32-chars

# Site
SITE_TITLE="Basehim"
SITE_TAGLINE="A Modern API-First CMS"
ADMIN_EMAIL=admin@example.com
