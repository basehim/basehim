#==============================================================================
# Basehim Environment Configuration
# Copy this file to .env and edit the values for your installation.
#==============================================================================

# Application
APP_NAME="Basehim"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_KEY=

# Database (cPanel MySQL)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=basehim
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
# Prefixes every table Basehim creates, including the tables apps create for
# themselves — so several sites can share one database, which is the norm on
# shared hosting where you get a fixed number of them.
#
# Leave it empty: the installer picks a random one (three characters and an
# underscore, e.g. k7q_) so each site's table names are unique and can't be
# guessed. Set it only if you want a prefix of your own, before installing,
# and never change it afterwards: that points the site at tables that do not
# exist. Letters, numbers and underscores only.
DB_PREFIX=

# JWT
JWT_SECRET=please-change-this-to-a-long-random-string-at-least-32-chars

# Site
SITE_TITLE="Basehim"
SITE_TAGLINE="A Modern API-First CMS"
ADMIN_EMAIL=admin@example.com

# Optional ----------------------------------------------------------------------
# Proxies in front of this site whose X-Forwarded-For / X-Forwarded-Proto
# headers are believed: IPs or CIDR ranges, comma-separated (a load balancer,
# a reverse proxy on this server). Cloudflare is recognised without this.
# TRUSTED_PROXIES=
# Private hosts or ranges apps may reach through api()->http() (normally only
# public internet addresses are allowed): comma-separated names, IPs or CIDRs.
# HTTP_ALLOW_PRIVATE=
