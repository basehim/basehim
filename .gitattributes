# Normalise line endings. Basehim is developed on Windows/XAMPP and deployed to
# Linux shared hosting, so let Git store LF and check out whatever is native.
* text=auto eol=lf

# Explicitly text
*.php     text eol=lf
*.md      text eol=lf
*.css     text eol=lf
*.js      text eol=lf
*.json    text eol=lf
*.sql     text eol=lf
*.html    text eol=lf
*.htaccess text eol=lf
.env.example text eol=lf

# Explicitly binary — never diff or convert
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.ico     binary
*.woff    binary
*.woff2   binary
*.ttf     binary
*.eot     binary
*.zip     binary

# Minified vendor bundles: collapse in diffs and exclude from language stats
*.min.css linguist-vendored -diff
*.min.js  linguist-vendored -diff

# Language detection: this is a PHP project, not a CSS one
admin/assets/**    linguist-vendored
content/themes/*/assets/**  linguist-vendored
docs/**            linguist-documentation

# What the download zip and the CloudHim release sync do with each path
# (1.2.74, BH-018). The download zip is `git archive`, so export-ignore keeps a
# path out of it. CloudHim (1.3.4+) reads two more rules from this file:
#
#   export-ignore                 the repository's own: a release sync never
#                                 writes or deletes it, and it is not in the zip
#   basehim-sync                  written by a sync whenever a release ships it,
#                                 never deleted by one, and in the zip
#   export-ignore basehim-sync    written by a sync, never deleted, not in the zip
#
# docs/ is part of the download (changelogs, guides, example apps). tests/ is
# kept on GitHub but out of the download. Until 1.2.74 both were plain
# export-ignore, so neither ever reached the repository.
/docs           basehim-sync
/docs/audits    export-ignore
/tests          export-ignore basehim-sync
/.gitattributes export-ignore basehim-sync

# Build sources for the admin CSS (1.2.77): kept on GitHub, synced with each
# release, not in the download (the compiled tailwind.min.css is).
/tailwind.config.js     export-ignore basehim-sync
/package.json           export-ignore basehim-sync
/admin/assets/css/src   export-ignore basehim-sync

# Repository tooling: not in the download, never touched by a sync.
/.github        export-ignore
/.gitignore     export-ignore
/CONTRIBUTING.md export-ignore

# Retired paths: files releases no longer contain. Patches cannot delete files
# from sites, so an install updated by patches still has them. The CloudHim
# release sync (1.3.2+) leaves export-ignore paths to the repository, so
# listing them here keeps a sync from restoring them from such an install.
/CHANGELOG-*.md      export-ignore
/RELEASE-NOTES-*.md  export-ignore
/app/Http/Controllers/Web/CategoryPostController.php export-ignore
/admin/assets/css/dashboard.css export-ignore
