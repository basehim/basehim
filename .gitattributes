# Normalise line endings. Basehim is developed on Windows/XAMPP and deployed to
# Linux shared hosting, so let Git store LF and check out whatever is native.
* text=auto eol=lf

# Explicitly text
*.php     text eol=lf
*.md      text eol=lf
*.css     text eol=lf
*.js      text eol=lf
*.json    text eol=lf
*.sql     text eol=lf
*.html    text eol=lf
*.htaccess text eol=lf
.env.example text eol=lf

# Explicitly binary — never diff or convert
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.ico     binary
*.woff    binary
*.woff2   binary
*.ttf     binary
*.eot     binary
*.zip     binary

# Minified vendor bundles: collapse in diffs and exclude from language stats
*.min.css linguist-vendored -diff
*.min.js  linguist-vendored -diff

# Language detection: this is a PHP project, not a CSS one
admin/assets/**    linguist-vendored
content/themes/*/assets/**  linguist-vendored
docs/**            linguist-documentation

# Keep release archives lean
/.github        export-ignore
/.gitattributes export-ignore
/.gitignore     export-ignore
/docs           export-ignore
/CONTRIBUTING.md export-ignore
